@page "/"
@using System.Diagnostics
@using SpawnDev.BlazorJS
@using SpawnDev.BlazorJS.JSObjects
@using SpawnDev.BlazorJS.Toolbox
@using System.Runtime.InteropServices
@implements IDisposable

<PageTitle>BlazorJS HeapView Benchmark</PageTitle>

<div class="benchmark-app">
    <header class="benchmark-header">
        <h1>SpawnDev.BlazorJS HeapView Benchmark</h1>
        <p class="subtitle">Comparing .NET-to-JavaScript interop strategies for image data transfer</p>
        <div class="header-links">
            <a href="https://github.com/LostBeard/HeapViewTest" target="_blank">HeapViewTest on GitHub</a>
            <a href="https://github.com/LostBeard/SpawnDev.BlazorJS" target="_blank">SpawnDev.BlazorJS on GitHub</a>
        </div>
    </header>

    <section class="config-panel">
        <div class="config-row">
            <label>
                Image Size
                <select @bind="_selectedSize" disabled="@_running">
                    <option value="2000">2000 x 2000 (16 MB)</option>
                    <option value="4000">4000 x 4000 (64 MB)</option>
                    <option value="6000">6000 x 6000 (144 MB)</option>
                    <option value="8000">8000 x 8000 (256 MB)</option>
                </select>
            </label>
            <label>
                Iterations
                <select @bind="_iterations" disabled="@_running">
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </label>
            <label class="toggle-label">
                <span>Stress Test</span>
                <div class="toggle-row">
                    <input type="checkbox" @bind="_stressTest" disabled="@_running" />
                    <span class="toggle-hint">Force GC between iterations</span>
                </div>
            </label>
            <button class="btn-run" disabled="@_running" @onclick="RunAllBenchmarks">
                @if (_running)
                {
                    <span class="spinner"></span>
                    <span>Running...</span>
                }
                else
                {
                    <span>Run Benchmark</span>
                }
            </button>
        </div>
    </section>

    @if (_status != null)
    {
        <section class="status-bar">
            <div class="progress-track">
                <div class="progress-fill" style="width: @(_progressPct)%"></div>
            </div>
            <span class="status-text">@_status</span>
        </section>
    }

    @if (_results.Count > 0)
    {
        <section class="results-section">
            <h2>Results</h2>
            <div class="results-grid">
                @foreach (var summary in _results.OrderBy(r => r.Avg))
                {
                    var best = _results.OrderBy(r => r.Avg).First().Method;
                    var isBest = summary.Method == best;
                    <div class="result-card @(isBest ? "best" : "") @(summary.Errors > 0 ? "has-errors" : "")">
                        @if (isBest && summary.Errors == 0)
                        {
                            <span class="badge">Fastest</span>
                        }
                        @if (summary.Errors > 0)
                        {
                            <span class="badge badge-error">@summary.Errors Error@(summary.Errors > 1 ? "s" : "")</span>
                        }
                        <h3>@summary.Label</h3>
                        <p class="description">@summary.Description</p>
                        <div class="stat-grid">
                            <div class="stat">
                                <span class="stat-value">@FormatMs(summary.Avg)</span>
                                <span class="stat-label">Avg</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@FormatMs(summary.Min)</span>
                                <span class="stat-label">Min</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@FormatMs(summary.Max)</span>
                                <span class="stat-label">Max</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@FormatThroughput(summary.AvgThroughput)</span>
                                <span class="stat-label">Throughput</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="results-section">
            <h2>GC Pressure</h2>
            <div class="results-grid">
                @foreach (var summary in _results.OrderBy(r => r.Avg))
                {
                    var lowestGc = _results.OrderBy(r => r.TotalGen0 + r.TotalGen1 + r.TotalGen2).First().Method;
                    var isBest = summary.Method == lowestGc;
                    <div class="result-card @(isBest ? "best" : "")">
                        @if (isBest)
                        {
                            <span class="badge badge-gc">Lowest GC</span>
                        }
                        <h3>@summary.Label</h3>
                        <div class="stat-grid stat-grid-3">
                            <div class="stat">
                                <span class="stat-value">@summary.TotalGen0</span>
                                <span class="stat-label">Gen 0</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@summary.TotalGen1</span>
                                <span class="stat-label">Gen 1</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@summary.TotalGen2</span>
                                <span class="stat-label">Gen 2</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@FormatBytes(summary.PeakMemory)</span>
                                <span class="stat-label">Peak Memory</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">@FormatBytes(summary.MemoryDelta)</span>
                                <span class="stat-label">Memory Delta</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value @(summary.Errors > 0 ? "stat-error" : "stat-ok")">@summary.Errors</span>
                                <span class="stat-label">Detach Errors</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="chart-section">
            <h2>Comparison</h2>
            <canvas @ref="_chartCanvasRef" width="700" height="350"></canvas>
        </section>

        <section class="details-section">
            <h2>All Iterations</h2>
            <table>
                <thead>
                    <tr>
                        <th>Method</th>
                        <th>Iter</th>
                        <th>Time</th>
                        <th>Throughput</th>
                        <th>Gen0</th>
                        <th>Gen1</th>
                        <th>Gen2</th>
                        <th>Memory</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in _allRuns)
                    {
                        <tr class="@(run.Error != null ? "row-error" : "")">
                            <td>@run.Label</td>
                            <td>@run.Iteration</td>
                            <td>@FormatMs(run.TimeMs)</td>
                            <td>@FormatThroughput(run.Throughput)</td>
                            <td>@run.Gen0</td>
                            <td>@run.Gen1</td>
                            <td>@run.Gen2</td>
                            <td>@FormatBytes(run.MemoryAfter)</td>
                            <td class="@(run.Error != null ? "status-error" : "status-ok")">@(run.Error ?? "OK")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <footer class="benchmark-footer">
        Powered by <a href="https://github.com/LostBeard/SpawnDev.BlazorJS" target="_blank">SpawnDev.BlazorJS</a>
    </footer>
</div>

<canvas @ref="_workCanvasRef" width="1" height="1" style="display:none;"></canvas>

@code {
    enum TestType { BuiltIn, HeapViewCopy, HeapViewDirect }

    record RunResult(
        TestType Method, string Label, int Iteration,
        double TimeMs, double Throughput,
        int Gen0, int Gen1, int Gen2,
        long MemoryAfter, string? Error);

    class MethodSummary
    {
        public TestType Method { get; init; }
        public string Label { get; init; } = "";
        public string Description { get; init; } = "";
        public double Avg { get; init; }
        public double Min { get; init; }
        public double Max { get; init; }
        public double AvgThroughput { get; init; }
        public int TotalGen0 { get; init; }
        public int TotalGen1 { get; init; }
        public int TotalGen2 { get; init; }
        public long PeakMemory { get; init; }
        public long MemoryDelta { get; init; }
        public int Errors { get; init; }
    }

    [Inject] BlazorJSRuntime JS { get; set; } = default!;

    ElementReference _workCanvasRef;
    ElementReference _chartCanvasRef;
    HTMLCanvasElement? _workCanvas;
    CanvasRenderingContext2D? _workCtx;

    bool _running;
    bool _stressTest;
    string? _status;
    double _progressPct;
    int _selectedSize = 4000;
    int _iterations = 5;

    List<MethodSummary> _results = new();
    List<RunResult> _allRuns = new();
    byte[]? _data;

    static readonly Dictionary<TestType, (string Label, string Desc)> MethodInfo = new()
    {
        [TestType.BuiltIn] = (".NET Built-in", "Default byte[] serialization. Creates a full copy in JS memory."),
        [TestType.HeapViewCopy] = ("HeapView Copy", "Fast copy via Uint8ClampedArray constructor from pinned .NET memory."),
        [TestType.HeapViewDirect] = ("HeapView Direct", "Zero-copy. Pins .NET memory and passes it directly to PutImageData."),
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _workCanvas = new HTMLCanvasElement(_workCanvasRef);
            _workCtx = _workCanvas.Get2DContext();
        }
    }

    async Task RunAllBenchmarks()
    {
        if (_workCanvas == null || _workCtx == null) return;
        _running = true;
        _results.Clear();
        _allRuns.Clear();
        StateHasChanged();

        var w = _selectedSize;
        var h = _selectedSize;
        var length = w * h * 4;

        // Generate test data
        if (_data?.Length != length)
        {
            _status = "Generating test data...";
            _progressPct = 0;
            StateHasChanged();
            await Task.Delay(10);

            _data = new byte[length];
            for (var i = 0; i < _data.Length; i += 4)
            {
                _data[i] = (byte)i;
                _data[i + 1] = (byte)(255 - i);
                _data[i + 2] = (byte)(255 - i);
                _data[i + 3] = 255;
            }
        }

        _workCanvas.Width = w;
        _workCanvas.Height = h;

        var methods = new[] { TestType.HeapViewDirect, TestType.HeapViewCopy, TestType.BuiltIn };
        var totalSteps = methods.Length * _iterations;
        var currentStep = 0;

        foreach (var method in methods)
        {
            var info = MethodInfo[method];
            var times = new List<double>();
            var errors = 0;
            var methodRuns = new List<RunResult>();

            // Snapshot GC baseline for this method
            var baseGen0 = GC.CollectionCount(0);
            var baseGen1 = GC.CollectionCount(1);
            var baseGen2 = GC.CollectionCount(2);
            var baseMemory = GC.GetTotalMemory(false);

            // Warmup run (not counted)
            _status = $"Warming up {info.Label}...";
            _progressPct = (double)currentStep / totalSteps * 100;
            StateHasChanged();
            await Task.Delay(10);
            RunSingle(method, w, h, _data, out _);

            // Reset baseline after warmup
            baseGen0 = GC.CollectionCount(0);
            baseGen1 = GC.CollectionCount(1);
            baseGen2 = GC.CollectionCount(2);
            baseMemory = GC.GetTotalMemory(false);

            for (int i = 0; i < _iterations; i++)
            {
                currentStep++;
                _status = $"Running {info.Label} — iteration {i + 1}/{_iterations}";
                _progressPct = (double)currentStep / totalSteps * 100;
                StateHasChanged();
                await Task.Delay(5);

                if (_stressTest)
                {
                    // Force GC and allocate temp arrays to provoke heap growth / ArrayBuffer detachment
                    GC.Collect(2, GCCollectionMode.Forced, true);
                    GC.WaitForPendingFinalizers();
                    // Allocate and release varying-size temp arrays to pressure the heap
                    for (int a = 0; a < 5; a++)
                    {
                        var temp = new byte[(a + 1) * 25_000_000];
                        temp[0] = 1; // ensure not optimized away
                    }
                }

                var gen0Before = GC.CollectionCount(0);
                var gen1Before = GC.CollectionCount(1);
                var gen2Before = GC.CollectionCount(2);

                var ms = RunSingle(method, w, h, _data, out var error);

                var gen0Delta = GC.CollectionCount(0) - gen0Before;
                var gen1Delta = GC.CollectionCount(1) - gen1Before;
                var gen2Delta = GC.CollectionCount(2) - gen2Before;
                var memAfter = GC.GetTotalMemory(false);

                var throughput = error == null ? length / (ms / 1000.0) : 0;
                if (error != null) errors++;

                var run = new RunResult(method, info.Label, i + 1, ms, throughput,
                    gen0Delta, gen1Delta, gen2Delta, memAfter, error);
                _allRuns.Add(run);
                methodRuns.Add(run);
                if (error == null) times.Add(ms);
            }

            var totalGen0 = GC.CollectionCount(0) - baseGen0;
            var totalGen1 = GC.CollectionCount(1) - baseGen1;
            var totalGen2 = GC.CollectionCount(2) - baseGen2;
            var peakMemory = methodRuns.Max(r => r.MemoryAfter);
            var endMemory = GC.GetTotalMemory(false);

            var avg = times.Count > 0 ? times.Average() : 0;
            _results.Add(new MethodSummary
            {
                Method = method,
                Label = info.Label,
                Description = info.Desc,
                Avg = avg,
                Min = times.Count > 0 ? times.Min() : 0,
                Max = times.Count > 0 ? times.Max() : 0,
                AvgThroughput = avg > 0 ? length / (avg / 1000.0) : 0,
                TotalGen0 = totalGen0,
                TotalGen1 = totalGen1,
                TotalGen2 = totalGen2,
                PeakMemory = peakMemory,
                MemoryDelta = endMemory - baseMemory,
                Errors = errors,
            });
        }

        _status = null;
        _progressPct = 100;
        _running = false;
        StateHasChanged();
        await Task.Delay(10);

        DrawChart();
    }

    double RunSingle(TestType method, int w, int h, byte[] data, out string? error)
    {
        error = null;
        var sw = Stopwatch.StartNew();
        try
        {
            switch (method)
            {
                case TestType.HeapViewDirect:
                    _workCtx!.PutImageBytes(data, w, h);
                    break;
                case TestType.BuiltIn:
                    using (var uint8Array = JS.ReturnMe<Uint8Array>(data))
                    using (var arrayBuffer = uint8Array.Buffer)
                    using (var uint8ClampedArray = new Uint8ClampedArray(arrayBuffer))
                    using (var imageData = new ImageData(uint8ClampedArray, w, h))
                    {
                        _workCtx!.PutImageData(imageData, 0, 0);
                    }
                    break;
                case TestType.HeapViewCopy:
                    using (var uint8ClampedArray = new Uint8ClampedArray(data))
                    using (var imageData = new ImageData(uint8ClampedArray, w, h))
                    {
                        _workCtx!.PutImageData(imageData, 0, 0);
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message.Length > 80 ? ex.Message[..80] + "..." : ex.Message;
        }
        sw.Stop();
        return sw.Elapsed.TotalMilliseconds;
    }

    void DrawChart()
    {
        var chartCanvas = new HTMLCanvasElement(_chartCanvasRef);
        var ctx = chartCanvas.Get2DContext();

        var cw = 700.0;
        var ch = 350.0;

        // Clear
        ctx.ClearRect(0, 0, cw, ch);

        var ordered = _results.OrderByDescending(r => r.Avg).ToList();
        var maxVal = ordered.Max(r => r.Max);
        if (maxVal <= 0) { ctx.Dispose(); chartCanvas.Dispose(); return; }

        var barAreaTop = 40.0;
        var barAreaBottom = ch - 50;
        var barAreaLeft = 140.0;
        var barAreaRight = cw - 30;
        var barAreaHeight = barAreaBottom - barAreaTop;
        var barAreaWidth = barAreaRight - barAreaLeft;

        // Title
        ctx.Font = "bold 16px system-ui, sans-serif";
        ctx.FillStyle = "#e2e8f0";
        ctx.TextAlign = "center";
        ctx.FillText("Average Time (lower is better)", cw / 2, 24);

        // Grid lines
        ctx.StrokeStyle = "#2a2d3a";
        ctx.LineWidth = 1;
        var gridSteps = 5;
        ctx.Font = "12px system-ui, sans-serif";
        ctx.FillStyle = "#64748b";
        ctx.TextAlign = "right";
        for (int i = 0; i <= gridSteps; i++)
        {
            var x = barAreaLeft + (barAreaWidth * i / gridSteps);
            ctx.BeginPath();
            ctx.MoveTo(x, barAreaTop - 5);
            ctx.LineTo(x, barAreaBottom);
            ctx.Stroke();

            var val = maxVal * i / gridSteps;
            ctx.FillText($"{val:F0} ms", x, barAreaBottom + 18);
        }
        ctx.TextAlign = "left";

        // Bars
        var barCount = ordered.Count;
        var barSpacing = barAreaHeight / barCount;
        var barHeight = barSpacing * 0.6;
        string[] colors = { "#3b82f6", "#10b981", "#a78bfa" };

        for (int i = 0; i < ordered.Count; i++)
        {
            var r = ordered[i];
            var y = barAreaTop + (barSpacing * i) + (barSpacing - barHeight) / 2;
            var barW = (r.Avg / maxVal) * barAreaWidth;

            // Min-max range line
            var minX = barAreaLeft + (r.Min / maxVal) * barAreaWidth;
            var maxX = barAreaLeft + (r.Max / maxVal) * barAreaWidth;
            ctx.StrokeStyle = "#475569";
            ctx.LineWidth = 2;
            ctx.BeginPath();
            ctx.MoveTo(minX, y + barHeight / 2);
            ctx.LineTo(maxX, y + barHeight / 2);
            ctx.Stroke();

            // Bar
            ctx.FillStyle = colors[i % colors.Length];
            ctx.FillRect(barAreaLeft, y, barW, barHeight);

            // Value label on bar
            ctx.FillStyle = "#e2e8f0";
            ctx.Font = "bold 13px system-ui, sans-serif";
            ctx.TextAlign = "left";
            ctx.FillText($"{r.Avg:F1} ms", barAreaLeft + barW + 6, y + barHeight / 2 + 5);

            // Method label
            ctx.FillStyle = "#94a3b8";
            ctx.Font = "13px system-ui, sans-serif";
            ctx.TextAlign = "right";
            ctx.FillText(r.Label, barAreaLeft - 10, y + barHeight / 2 + 5);
        }

        ctx.Dispose();
        chartCanvas.Dispose();
    }

    static string FormatMs(double ms) => ms < 1 ? $"{ms:F3} ms" : $"{ms:F1} ms";

    static string FormatThroughput(double bps)
    {
        if (bps <= 0) return "—";
        var mbps = bps / 1_000_000;
        return mbps >= 1000 ? $"{mbps / 1000:F2} GB/s" : $"{mbps:F1} MB/s";
    }

    static string FormatBytes(long bytes)
    {
        if (bytes < 0) return $"-{FormatBytes(-bytes)}";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    public void Dispose()
    {
        _workCtx?.Dispose();
        _workCanvas?.Dispose();
    }
}
